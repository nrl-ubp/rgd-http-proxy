      <child xsi:type="archimate:Group" id="id-a3a2f571db7f4c3aa0516ef627893a92" name="VDI User" targetConnections="id-02563ed3c1d2404bb14e70a9b13ada5a" textAlignment="1">
        <bounds x="276" y="864" width="325" height="140"/>
        <child xsi:type="archimate:DiagramObject" id="id-39a5935454524b13ad90829533416eee" targetConnections="id-a840604481774b5b9451df759388e140" archimateElement="id-4af83a6f44c4457d8b351e670cfee06b">
