[
  {
    "endpoint-path": "/api/v1/persons/\\d+",
    "endpoint-methods": [
      "POST",
      "PUT"
    ],
    "endpoint-transform-when": "BEFORE",
    "right-context": {
      "Target": "WDX1",
      "Module": "WDX1Proxy",
      "Right": "Transform"
    },
    "processing-context": {
      "Action": "Unprotect",
      "Module": "WDX1Proxy",
      "Target": "WDX1"
    },
    "header-transform-configs": [
      {
        "name": "X-transform-header",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      }
    ],
    "entity-transform-configs": [
      {
        "json-path": "$.[*]lastName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.[*]firstName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.[*]birthDate",
        "rps-class-name": "Person",
        "rps-property-name": "Date"
      }
    ],
    "url-query-transform-configs": [
      {
        "name": "person-name",
        "regexp": false,
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "name": "email.*",
        "regexp": true,
        "rps-class-name": "Person",
        "rps-property-name": "Email"
      }
    ],
    "url-path-transform-configs": [
      {
        "name-or-position": "person",
        "regexp": false,
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      }
    ]
  },
  {
    "endpoint-path": "/api/v1/persons/\\d+",
    "endpoint-methods": [
      "GET"
    ],
    "endpoint-transform-when": "AFTER",
    "right-context": {
      "Target": "WDX1",
      "Module": "WDX1Proxy",
      "Right": "Transform"
    },
    "processing-context": {
      "Action": "Protect",
      "Module": "WDX1Proxy",
      "Target": "WDX1"
    },
    "header-transform-configs": [
      {
        "name": "X-transform-header",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      }
    ],
    "entity-transform-configs": [
      {
        "json-path": "$.[*]lastName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.[*]firstName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.[*]birthDate",
        "rps-class-name": "Person",
        "rps-property-name": "Date"
      }
    ]
  }
]
