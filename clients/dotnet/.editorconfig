root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,xml,csproj,props,slnx,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
dotnet_style_readonly_field = true:warning

# Logging through LoggerMessage delegates is not worth it for this code base.
dotnet_diagnostic.CA1848.severity = none
# ConfigureAwait is irrelevant in ASP.NET Core.
dotnet_diagnostic.CA2007.severity = none
# Same family as CA1848: flags any argument that is not a constant.
dotnet_diagnostic.CA1873.severity = none
