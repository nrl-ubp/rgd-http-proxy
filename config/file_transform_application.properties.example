# ========================================
# File Transformation Configuration
# ========================================

# Enable file transformation feature
# Set to true to activate file processing
proxy.file-transform.enabled=false

# Path to the file transformation configuration file
# This file defines source/target directories and transformation rules
proxy.file-transform.config-file=./config/file_transform_config.json

# Note: scan-interval-seconds has been moved to individual configurations
# in file_transform_config.json. Each configuration can now have its own
# scan interval:
#   - Positive value (e.g., 30): Automatic processing every N seconds
#   - Zero or negative: On-demand processing only (via REST API)

# ========================================
# Usage Instructions
# ========================================
# 1. Set proxy.file-transform.enabled=true
# 2. Configure file_transform_config.json with your directories
# 3. Set scan-interval-seconds for each configuration:
#      30 = Process automatically every 30 seconds
#      0  = Process only on-demand via REST API
# 4. Start the application
# 5. For automatic processing: Files processed per configured intervals
# 6. For on-demand processing: Use REST API endpoint
# 7. Check error directories for any failed files
# 8. Monitor logs for processing status

# ========================================
# REST API Endpoints
# ========================================
# GET  /api/file-transform/configurations         - List all configurations
# GET  /api/file-transform/configuration/{name}   - Get configuration details
# POST /api/file-transform/trigger/{name}         - Trigger processing for a config

# Examples:
# curl http://localhost:8080/api/file-transform/configurations
# curl -X POST http://localhost:8080/api/file-transform/trigger/"Person%20Data%20Protection"

