{
  "right-context": {
    "Target": "WDX1",
    "Module": "RoseGarden",
    "Right": "Transform"
  },
  "processing-context": {
    "Action": "Unprotect",
    "Target": "WDX1"
  },
  "DataMappings": [
    {
      "Regex": "(RG\\{[A-Z2-7x]{2}[a-zA-Z0-9\\-]{8}[a-zA-Z0-9]+\\})"
    },
    {
      "Regex": "(^RG\\{[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@example\\.com$)",
      "ClassName": "Person",
      "PropertyName": "Email"
    },
    {
      "Regex": "-888\\d{12}\\.8888",
      "ClassName": "Other",
      "PropertyName": "Number"
    },
    {
      "Regex": "\\b(?<Year>[3-9][0-9]{3})-(?<Month>0[1-9]|1[0-2])-(?<Day>0[1-9]|[12][0-9]|3[01])\\b",
      "ClassName": "Person",
      "PropertyName": "Date"
    }
  ]
  "column-mappings": [
    {
      "table": "PERSON",
      "column": "FIRST_NAME",
      "rps-class-name": "Person",
      "rps-property-name": "shortString"
    },
    {
      "table": "PERSON",
      "column": "LAST_NAME",
      "rps-class-name": "Person",
      "rps-property-name": "shortString"
    },
    {
      "table": "PERSON",
      "column": "BIRTH_DATE",
      "rps-class-name": "Person",
      "rps-property-name": "birthDate"
    },
    {
      "table": "*",
      "column": "EMAIL",
      "rps-class-name": "Person",
      "rps-property-name": "email"
    }
  ]
}
