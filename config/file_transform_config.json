[
  {
    "name": "Person Data Protection",
    "source-directory": "./data/source",
    "target-directory": "./data/target",
    "error-directory": "./data/error",
    "work-in-progress-suffix": ".processing",
    "file-pattern": ".*\\.json$",
    "preserve-directory-structure": true,
    "scan-interval-seconds": 30,
    "right-context": {
      "Target" : "WDX1",
      "Module": "WDX1Proxy",
      "Right": "Transform"
    },
    "processing-context": {
      "Target" : "WDX1",
      "Module": "WDX1Proxy"
    },
    "entity-transform-configs": [
      {
        "json-path": "$.[*].lastName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.[*].firstName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.[*].birthDate",
        "rps-class-name": "Person",
        "rps-property-name": "BirthDate"
      },
      {
        "json-path": "$.lastName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.firstName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.birthDate",
        "rps-class-name": "Person",
        "rps-property-name": "BirthDate"
      }
    ]
  },
  {
    "name": "Person Data Unprotection",
    "source-directory": "./data/unprotect-source",
    "target-directory": "./data/unprotect-target",
    "error-directory": "./data/unprotect-error",
    "work-in-progress-suffix": ".processing",
    "file-pattern": ".*\\.json$",
    "preserve-directory-structure": true,
    "scan-interval-seconds": 0,
    "right-context": {
      "Location": "Onshore"
    },
    "processing-context": {
      "Action": "Unprotect",
      "Location": "Onshore"
    },
    "entity-transform-configs": [
      {
        "json-path": "$.[*].lastName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.[*].firstName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.[*].birthDate",
        "rps-class-name": "Person",
        "rps-property-name": "BirthDate"
      },
      {
        "json-path": "$.lastName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.firstName",
        "rps-class-name": "Person",
        "rps-property-name": "ShortString"
      },
      {
        "json-path": "$.birthDate",
        "rps-class-name": "Person",
        "rps-property-name": "BirthDate"
      }
    ]
  }
]
